    "@nestjs/config": "^4.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@prisma/client": "^6.11.0",
    "bullmq": "^5.56.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "better-auth": "^1.2.8",
    "ioredis": "^5.4.2",
    "zod": "^3.25.76",
