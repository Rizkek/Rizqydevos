{
  "name": "devos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:clean": "Remove-Item -Recurse -Force apps\\web\\.next, apps\\api\\dist, .turbo -ErrorAction SilentlyContinue; turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@prisma/config": "^7.9.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "prisma": "7.9.1",
    "turbo": "2.10.10",
    "typescript": "^6.0.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.3.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "@types/pg": "^8.23.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.1",
    "lucide-react": "^1.33.0",
    "pg": "^8.23.0"
  }
}
