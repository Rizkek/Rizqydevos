# ============================================================================
# DevOS — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# For local development with docker-compose.dev.yml:
DATABASE_URL=postgresql://devos:devos_secret@localhost:5432/devos

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_here_minimum_32_characters_long

# GitHub OAuth (optional — for GitHub login)
# Create at: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
# Create at: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=devos-storage

# ── AI Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Encryption ───────────────────────────────────────────────────────────────
# Used to encrypt secrets in the database. Generate with: openssl rand -base64 32
# WARNING: Changing this will invalidate all stored secrets!
ENCRYPTION_KEY=your_encryption_key_here_minimum_32_chars

# ── Meilisearch ──────────────────────────────────────────────────────────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=devos_meili_key_dev

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# Prefix with NEXT_PUBLIC_ to expose to the browser
NEXT_PUBLIC_API_URL=http://localhost:3001
